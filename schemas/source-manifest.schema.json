{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bardooran/somali-ai-data/schemas/source-manifest.schema.json",
  "title": "Somali AI Source Manifest",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "name", "license_status", "roles"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "upstream_repository": {"type": ["string", "null"]},
          "upstream_dataset": {"type": ["string", "null"]},
          "pinned_version": {"type": ["string", "null"]},
          "license_status": {
            "type": "string",
            "enum": ["clear", "mixed", "restricted", "unknown"]
          },
          "per_item_license_required": {"type": "boolean"},
          "redistribution_default": {
            "type": "string",
            "enum": ["allowed", "metadata_only", "verify_per_item", "blocked"]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "independence_group": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
